# Copia este archivo como ".env" (sin .example) y completa tus propios valores.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

# Seguridad
SECRET_KEY=genera-una-clave-nueva-y-larga-aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos
# DB_ENGINE=mysql   -> usa MySQL/MariaDB (recomendado, requerido para phpMyAdmin)
# DB_ENGINE=sqlite  -> usa SQLite local, solo para pruebas rapidas sin MySQL instalado
DB_ENGINE=mysql
DB_NAME=gestion_laserena
DB_USER=gestion_user
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
# Ajusta el puerto al de tu servidor local: MariaDB del equipo usa 3307;
# MySQL/MariaDB con configuracion estandar (incluida EC2) suele usar 3306.
DB_PORT=3306

# Reglas configurables (opcionales; estos son los valores por defecto)
# Tamaño máximo de una evidencia, en MB
# EVIDENCIA_TAMANO_MAXIMO_MB=5
# Días de anticipación para marcar un compromiso como próximo a vencer
# COMPROMISO_DIAS_ALERTA=3
# Días sin registrar actividades a partir de los cuales se emite una alerta
# ALERTA_DIAS_SIN_REGISTRO=7

# Correo para la recuperación de contraseña
# Sin EMAIL_BACKEND, los correos se imprimen en la consola donde corre Django (desarrollo).
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" de 16 caracteres
# en https://myaccount.google.com/apppasswords (pasos en el README, «Configurar el correo»).
# Prueba el envío con: python manage.py sendtestemail tu-correo@ejemplo.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contrasena-de-aplicacion
# DEFAULT_FROM_EMAIL=SGR La Serena <tu-cuenta@gmail.com>
# Vigencia del enlace de recuperación, en segundos
# PASSWORD_RESET_TIMEOUT=3600
