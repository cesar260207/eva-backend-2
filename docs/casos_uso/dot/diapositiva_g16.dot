digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar ítems medibles y metas (G16 · EP-02)</b>>; color="#333333"; penwidth=1.4; margin=14;
"item_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar ítem medible</b><br/><font point-size="9" color="#555555">CU-04</font>>];
"item_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar ítems medibles</b><br/><font point-size="9" color="#555555">CU-128</font>>];
"item_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar ítem medible</b><br/><font point-size="9" color="#555555">CU-129</font>>];
"item_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar ítem medible</b><br/><font point-size="9" color="#555555">CU-130</font>>];
"matriz" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Cargar matriz de cargos</b><br/><font point-size="9" color="#555555">CU-131</font>>];
"meta_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar meta</b><br/><font point-size="9" color="#555555">CU-05</font>>];
"meta_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar metas</b><br/><font point-size="9" color="#555555">CU-132</font>>];
"meta_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar meta</b><br/><font point-size="9" color="#555555">CU-133</font>>];
"meta_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar meta</b><br/><font point-size="9" color="#555555">CU-134</font>>];
"item_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar reglas de configuración<br/><font point-size="9" color="#555555">CU-04.1</font>>];
"meta_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar parámetros de meta<br/><font point-size="9" color="#555555">CU-05.1</font>>];
"recalcular" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Recalcular indicadores automáticamente<br/><font point-size="9" color="#555555">CU-06.1</font>>];
"buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar y filtrar<br/><font point-size="9" color="#555555">CU-29</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"item_error" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Bloquear guardado por ponderación inválida<br/><font point-size="9" color="#555555">CU-04.2</font>>];
"meta_error" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Bloquear guardado por valor inválido<br/><font point-size="9" color="#555555">CU-05.2</font>>];
"periodo_cerrado" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Restricción por período cerrado<br/><font point-size="9" color="#555555">CU-28.1</font>>];
"meta_cerrado" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Notificar período cerrado<br/><font point-size="9" color="#555555">CU-05.3</font>>];
"protegido" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Impedir eliminación con datos relacionados<br/><font point-size="9" color="#555555">CU-127</font>>];
"meta_ind" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Advertir indicadores asociados<br/><font point-size="9" color="#555555">CU-135</font>>];
"sin_resultados" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-70</font>>];
}
"A_Coordinador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Coordinador</b>>, fontsize=11];
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
{rank=same; "A_Coordinador"; "A_Administrador";}
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "item_reg"; "item_con"; "item_mod"; "item_eli"; "matriz"; "meta_reg"; "meta_con"; "meta_mod"; "meta_eli";}
"A_Coordinador" -> "item_reg" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "item_reg" [arrowhead=none, penwidth=1.1, weight=3];
"item_reg" -> "item_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"item_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "item_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "item_con" [arrowhead=none, penwidth=1.1, weight=3];
"item_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "item_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "item_mod" [arrowhead=none, penwidth=1.1, weight=3];
"item_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"item_mod" -> "item_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"item_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "item_eli" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "item_eli" [arrowhead=none, penwidth=1.1, weight=3];
"item_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"item_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "matriz" [arrowhead=none, penwidth=1.1, weight=3];
"A_Coordinador" -> "meta_reg" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "meta_reg" [arrowhead=none, penwidth=1.1, weight=3];
"meta_reg" -> "meta_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"meta_reg" -> "recalcular" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"meta_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "meta_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "meta_con" [arrowhead=none, penwidth=1.1, weight=3];
"meta_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "meta_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "meta_mod" [arrowhead=none, penwidth=1.1, weight=3];
"meta_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"meta_mod" -> "meta_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"meta_mod" -> "recalcular" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"meta_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "meta_eli" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "meta_eli" [arrowhead=none, penwidth=1.1, weight=3];
"meta_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"meta_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"item_reg" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"item_mod" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"item_eli" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"meta_reg" -> "meta_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"meta_mod" -> "meta_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"meta_eli" -> "meta_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"item_eli" -> "protegido" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"meta_eli" -> "meta_ind" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"item_valid" -> "item_error" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"meta_valid" -> "meta_error" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"buscar" -> "sin_resultados" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}