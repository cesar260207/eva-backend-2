digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar ajustes de puntaje (G06 · EP-02)</b>>; color="#333333"; penwidth=1.4; margin=14;
"aj_inf" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Informar felicitación o reclamo</b><br/><font point-size="9" color="#555555">CU-64</font>>];
"aj_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar ajustes</b><br/><font point-size="9" color="#555555">CU-65</font>>];
"aj_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar ajuste</b><br/><font point-size="9" color="#555555">CU-66</font>>];
"aj_dec" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Aplicar o rechazar ajuste</b><br/><font point-size="9" color="#555555">CU-67</font>>];
"aj_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar datos de ajuste<br/><font point-size="9" color="#555555">CU-68</font>>];
"buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar y filtrar<br/><font point-size="9" color="#555555">CU-29</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"error_valid" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Informar error de validación<br/><font point-size="9" color="#555555">CU-69</font>>];
"periodo_cerrado" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Restricción por período cerrado<br/><font point-size="9" color="#555555">CU-28.1</font>>];
"sin_resultados" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-70</font>>];
}
"A_Delegado" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Delegado</b>>, fontsize=11];
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
"A_Coordinador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Coordinador</b>>, fontsize=11];
{rank=same; "A_Delegado"; "A_Administrador"; "A_Coordinador";}
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "aj_inf"; "aj_con"; "aj_mod"; "aj_dec";}
"A_Delegado" -> "aj_inf" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "aj_inf" [arrowhead=none, penwidth=1.1, weight=3];
"aj_inf" -> "aj_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"aj_inf" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Delegado" -> "aj_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Coordinador" -> "aj_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "aj_con" [arrowhead=none, penwidth=1.1, weight=3];
"aj_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "aj_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "aj_mod" [arrowhead=none, penwidth=1.1, weight=3];
"aj_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"aj_mod" -> "aj_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"aj_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "aj_dec" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "aj_dec" [arrowhead=none, penwidth=1.1, weight=3];
"aj_dec" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"aj_dec" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"aj_inf" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"aj_mod" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"aj_dec" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"aj_valid" -> "error_valid" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"buscar" -> "sin_resultados" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}