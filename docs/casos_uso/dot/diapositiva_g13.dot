digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar funcionarios y usuarios (G13 · EP-08)</b>>; color="#333333"; penwidth=1.4; margin=14;
"fun_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar funcionario</b><br/><font point-size="9" color="#555555">CU-104</font>>];
"fun_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar funcionarios</b><br/><font point-size="9" color="#555555">CU-105</font>>];
"fun_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar funcionario</b><br/><font point-size="9" color="#555555">CU-106</font>>];
"fun_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar funcionario</b><br/><font point-size="9" color="#555555">CU-107</font>>];
"fun_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar datos de funcionario<br/><font point-size="9" color="#555555">CU-108</font>>];
"perfil" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Asignar perfil de acceso<br/><font point-size="9" color="#555555">CU-109</font>>];
"buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar y filtrar<br/><font point-size="9" color="#555555">CU-29</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"error_valid" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Informar error de validación<br/><font point-size="9" color="#555555">CU-69</font>>];
"usuario_dup" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Informar usuario duplicado<br/><font point-size="9" color="#555555">CU-110</font>>];
"propia_cuenta" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Impedir desactivar la propia cuenta<br/><font point-size="9" color="#555555">CU-111</font>>];
"desactivar" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Desactivar en vez de eliminar<br/><font point-size="9" color="#555555">CU-85</font>>];
"sin_resultados" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-70</font>>];
}
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
{rank=same; "A_Administrador";}
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "fun_reg"; "fun_con"; "fun_mod"; "fun_eli";}
"A_Administrador" -> "fun_reg" [arrowhead=none, penwidth=1.1, weight=3];
"fun_reg" -> "fun_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_reg" -> "perfil" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "fun_con" [arrowhead=none, penwidth=1.1, weight=3];
"fun_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "fun_mod" [arrowhead=none, penwidth=1.1, weight=3];
"fun_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_mod" -> "fun_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_mod" -> "perfil" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "fun_eli" [arrowhead=none, penwidth=1.1, weight=3];
"fun_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"fun_eli" -> "propia_cuenta" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"fun_eli" -> "desactivar" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"fun_valid" -> "error_valid" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"fun_valid" -> "usuario_dup" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"buscar" -> "sin_resultados" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}