digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar organizaciones comunitarias (G09 · EP-01)</b>>; color="#333333"; penwidth=1.4; margin=14;
"org_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar organización</b><br/><font point-size="9" color="#555555">CU-78</font>>];
"org_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar organizaciones</b><br/><font point-size="9" color="#555555">CU-79</font>>];
"org_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar organización</b><br/><font point-size="9" color="#555555">CU-80</font>>];
"org_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar organización</b><br/><font point-size="9" color="#555555">CU-81</font>>];
"org_exp" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Exportar organizaciones</b><br/><font point-size="9" color="#555555">CU-82</font>>];
"org_imp" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Importar organizaciones</b><br/><font point-size="9" color="#555555">CU-83</font>>];
"org_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar datos de organización<br/><font point-size="9" color="#555555">CU-84</font>>];
"buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar y filtrar<br/><font point-size="9" color="#555555">CU-29</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"error_valid" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Informar error de validación<br/><font point-size="9" color="#555555">CU-69</font>>];
"desactivar" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Desactivar en vez de eliminar<br/><font point-size="9" color="#555555">CU-85</font>>];
"sin_resultados" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-70</font>>];
}
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
"A_Usuario" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Usuario<br/>(cualquier perfil)</b>>, fontsize=11];
"A_Delegado" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Delegado</b>>, fontsize=11];
"A_Coordinador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Coordinador</b>>, fontsize=11];
{rank=same; "A_Administrador"; "A_Usuario"; "A_Delegado"; "A_Coordinador";}
"A_Administrador" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
"A_Delegado" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
"A_Coordinador" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "org_reg"; "org_con"; "org_mod"; "org_eli"; "org_exp"; "org_imp";}
"A_Administrador" -> "org_reg" [arrowhead=none, penwidth=1.1, weight=3];
"org_reg" -> "org_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"org_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Usuario" -> "org_con" [arrowhead=none, penwidth=1.1, weight=3];
"org_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Delegado" -> "org_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Coordinador" -> "org_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "org_mod" [arrowhead=none, penwidth=1.1, weight=3];
"org_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"org_mod" -> "org_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"org_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "org_eli" [arrowhead=none, penwidth=1.1, weight=3];
"org_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"org_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Usuario" -> "org_exp" [arrowhead=none, penwidth=1.1, weight=3];
"org_exp" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "org_imp" [arrowhead=none, penwidth=1.1, weight=3];
"org_eli" -> "desactivar" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"org_valid" -> "error_valid" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"buscar" -> "sin_resultados" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}