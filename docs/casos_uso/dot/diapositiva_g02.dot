digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar actividades (G02 · EP-01)</b>>; color="#333333"; penwidth=1.4; margin=14;
"act_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar actividad</b><br/><font point-size="9" color="#555555">CU-01</font>>];
"act_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar actividades</b><br/><font point-size="9" color="#555555">CU-41</font>>];
"act_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar actividad</b><br/><font point-size="9" color="#555555">CU-42</font>>];
"act_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar actividad</b><br/><font point-size="9" color="#555555">CU-43</font>>];
"comentar" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Comentar actividad</b><br/><font point-size="9" color="#555555">CU-24</font>>];
"act_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar campos de actividad<br/><font point-size="9" color="#555555">CU-01.1</font>>];
"codigo" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Generar código verificador<br/><font point-size="9" color="#555555">CU-10</font>>];
"puntaje" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Evaluar puntaje<br/><font point-size="9" color="#555555">CU-44</font>>];
"act_buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar actividad por código<br/><font point-size="9" color="#555555">CU-10.1</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"act_error" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Gestionar error de validación<br/><font point-size="9" color="#555555">CU-01.2</font>>];
"cierre_semanal" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Rechazar por cierre semanal<br/><font point-size="9" color="#555555">CU-46</font>>];
"tope_diario" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Rechazar por tope diario<br/><font point-size="9" color="#555555">CU-47</font>>];
"sin_puntaje" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Registrar sin puntaje<br/><font point-size="9" color="#555555">CU-48</font>>];
"vincular" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Vincular tarea del tubo de trabajo<br/><font point-size="9" color="#555555">CU-49</font>>];
"act_bloqueo" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Bloquear cambios a la actividad<br/><font point-size="9" color="#555555">CU-50</font>>];
"devolver" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Devolver a revisión<br/><font point-size="9" color="#555555">CU-51</font>>];
"concurrencia" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Controlar conflicto de concurrencia<br/><font point-size="9" color="#555555">CU-23.1</font>>];
"act_sin" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-10.2</font>>];
"denegar" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Denegar acceso por ámbito<br/><font point-size="9" color="#555555">CU-26.1</font>>];
}
"A_Usuario" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Usuario<br/>(cualquier perfil)</b>>, fontsize=11];
"A_Coordinador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Coordinador</b>>, fontsize=11];
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
"A_Profesional" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Profesional</b>>, fontsize=11];
"A_Delegado" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Delegado</b>>, fontsize=11];
{rank=same; "A_Usuario"; "A_Coordinador"; "A_Administrador"; "A_Profesional"; "A_Delegado";}
"A_Coordinador" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
"A_Administrador" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
"A_Profesional" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
"A_Delegado" -> "A_Usuario" [arrowhead=empty, arrowsize=1.1, penwidth=1.1, constraint=false];
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "act_reg"; "act_con"; "act_mod"; "act_eli"; "comentar";}
"A_Usuario" -> "act_reg" [arrowhead=none, penwidth=1.1, weight=3];
"act_reg" -> "act_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_reg" -> "codigo" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_reg" -> "puntaje" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Usuario" -> "act_con" [arrowhead=none, penwidth=1.1, weight=3];
"act_con" -> "act_buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Usuario" -> "act_mod" [arrowhead=none, penwidth=1.1, weight=3];
"act_mod" -> "act_buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_mod" -> "act_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_mod" -> "puntaje" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "act_eli" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "act_eli" [arrowhead=none, penwidth=1.1, weight=3];
"act_eli" -> "act_buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Profesional" -> "comentar" [arrowhead=none, penwidth=1.1, weight=3];
"A_Delegado" -> "comentar" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "comentar" [arrowhead=none, penwidth=1.1, weight=3];
"comentar" -> "act_buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"comentar" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"act_reg" -> "vincular" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"act_mod" -> "vincular" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"act_mod" -> "act_bloqueo" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"act_eli" -> "act_bloqueo" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"act_mod" -> "devolver" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"act_mod" -> "concurrencia" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"act_valid" -> "act_error" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"act_valid" -> "cierre_semanal" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"act_valid" -> "tope_diario" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"puntaje" -> "sin_puntaje" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"act_buscar" -> "act_sin" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"act_buscar" -> "denegar" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}