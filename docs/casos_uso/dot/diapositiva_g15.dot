digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar períodos y parámetros (G15 · EP-08)</b>>; color="#333333"; penwidth=1.4; margin=14;
"per_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar período</b><br/><font point-size="9" color="#555555">CU-117</font>>];
"per_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar períodos</b><br/><font point-size="9" color="#555555">CU-118</font>>];
"per_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar período</b><br/><font point-size="9" color="#555555">CU-119</font>>];
"per_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar período</b><br/><font point-size="9" color="#555555">CU-120</font>>];
"per_estado" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Abrir, cerrar o reabrir período</b><br/><font point-size="9" color="#555555">CU-28</font>>];
"par_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar parámetro</b><br/><font point-size="9" color="#555555">CU-121</font>>];
"par_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar parámetros</b><br/><font point-size="9" color="#555555">CU-122</font>>];
"par_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar parámetro</b><br/><font point-size="9" color="#555555">CU-25</font>>];
"par_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar parámetro</b><br/><font point-size="9" color="#555555">CU-123</font>>];
"per_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar datos de período<br/><font point-size="9" color="#555555">CU-124</font>>];
"par_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar datos de parámetro<br/><font point-size="9" color="#555555">CU-125</font>>];
"buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar y filtrar<br/><font point-size="9" color="#555555">CU-29</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"error_valid" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Informar error de validación<br/><font point-size="9" color="#555555">CU-69</font>>];
"reabrir" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Exigir motivo de reapertura<br/><font point-size="9" color="#555555">CU-126</font>>];
"periodo_cerrado" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Restricción por período cerrado<br/><font point-size="9" color="#555555">CU-28.1</font>>];
"protegido" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Impedir eliminación con datos relacionados<br/><font point-size="9" color="#555555">CU-127</font>>];
"sin_resultados" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-70</font>>];
}
"A_Coordinador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Coordinador</b>>, fontsize=11];
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
{rank=same; "A_Coordinador"; "A_Administrador";}
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "per_reg"; "per_con"; "per_mod"; "per_eli"; "per_estado"; "par_reg"; "par_con"; "par_mod"; "par_eli";}
"A_Coordinador" -> "per_reg" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "per_reg" [arrowhead=none, penwidth=1.1, weight=3];
"per_reg" -> "per_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"per_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "per_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "per_con" [arrowhead=none, penwidth=1.1, weight=3];
"per_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "per_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "per_mod" [arrowhead=none, penwidth=1.1, weight=3];
"per_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"per_mod" -> "per_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"per_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "per_eli" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "per_eli" [arrowhead=none, penwidth=1.1, weight=3];
"per_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"per_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "per_estado" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "per_estado" [arrowhead=none, penwidth=1.1, weight=3];
"per_estado" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"per_estado" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "par_reg" [arrowhead=none, penwidth=1.1, weight=3];
"par_reg" -> "par_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"par_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "par_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "par_con" [arrowhead=none, penwidth=1.1, weight=3];
"par_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "par_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "par_mod" [arrowhead=none, penwidth=1.1, weight=3];
"par_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"par_mod" -> "par_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"par_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Administrador" -> "par_eli" [arrowhead=none, penwidth=1.1, weight=3];
"par_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"par_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"per_estado" -> "reabrir" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"per_mod" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"par_reg" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"par_mod" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"par_eli" -> "periodo_cerrado" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"per_eli" -> "protegido" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"per_valid" -> "error_valid" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"par_valid" -> "error_valid" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"buscar" -> "sin_resultados" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}