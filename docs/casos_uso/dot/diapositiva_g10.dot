digraph G {
rankdir=LR; newrank=true; nodesep=0.22; ranksep=0.75; splines=true; pad=0.25;
graph [fontname="DejaVu Sans", fontsize=15, labelloc=t, labeljust=l];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, color="#333333", fontcolor="#444444"];
subgraph cluster_s { label=<<b>Gestionar delegaciones (G10 · EP-08)</b>>; color="#333333"; penwidth=1.4; margin=14;
"del_reg" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Registrar delegación</b><br/><font point-size="9" color="#555555">CU-86</font>>];
"del_con" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Consultar delegaciones</b><br/><font point-size="9" color="#555555">CU-87</font>>];
"del_mod" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Modificar delegación</b><br/><font point-size="9" color="#555555">CU-88</font>>];
"del_eli" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Eliminar delegación</b><br/><font point-size="9" color="#555555">CU-89</font>>];
"delegado" [shape=ellipse, style=filled, fillcolor="white", color="#8E2B24", penwidth=1.5, label=<<b>Asignar delegado</b><br/><font point-size="9" color="#555555">CU-90</font>>];
"del_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar datos de delegación<br/><font point-size="9" color="#555555">CU-91</font>>];
"asig_valid" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Validar asignación<br/><font point-size="9" color="#555555">CU-92</font>>];
"buscar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Buscar y filtrar<br/><font point-size="9" color="#555555">CU-29</font>>];
"auditar" [shape=ellipse, style=filled, fillcolor="#F4F4F4", color="#666666", penwidth=1.5, label=<Registrar en auditoría<br/><font point-size="9" color="#555555">CU-45</font>>];
"error_valid" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Informar error de validación<br/><font point-size="9" color="#555555">CU-69</font>>];
"desactivar" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Desactivar en vez de eliminar<br/><font point-size="9" color="#555555">CU-85</font>>];
"sin_resultados" [shape=ellipse, style=filled, fillcolor="white", color="#B5651D", penwidth=1.5, label=<Consulta sin coincidencias<br/><font point-size="9" color="#555555">CU-70</font>>];
}
"A_Coordinador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Coordinador</b>>, fontsize=11];
"A_Administrador" [shape=none, image="cu_v2/dot/_actor.png", labelloc=b, imagepos=tc, height=1.05, width=1.2, fixedsize=true, label=<<b>Administrador</b>>, fontsize=11];
{rank=same; "A_Coordinador"; "A_Administrador";}
label=<<font point-size="10" color="#444444">Rojo: caso de detalle · Gris: incluido (siempre ocurre) · Café: extensión (solo si se cumple su condición) · Triángulo: herencia</font>>; labelloc=b; labeljust=r;
{rank=same; "del_reg"; "del_con"; "del_mod"; "del_eli"; "delegado";}
"A_Coordinador" -> "del_reg" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "del_reg" [arrowhead=none, penwidth=1.1, weight=3];
"del_reg" -> "del_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"del_reg" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "del_con" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "del_con" [arrowhead=none, penwidth=1.1, weight=3];
"del_con" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "del_mod" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "del_mod" [arrowhead=none, penwidth=1.1, weight=3];
"del_mod" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"del_mod" -> "del_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"del_mod" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "del_eli" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "del_eli" [arrowhead=none, penwidth=1.1, weight=3];
"del_eli" -> "buscar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"del_eli" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"A_Coordinador" -> "delegado" [arrowhead=none, penwidth=1.1, weight=3];
"A_Administrador" -> "delegado" [arrowhead=none, penwidth=1.1, weight=3];
"delegado" -> "asig_valid" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"delegado" -> "auditar" [style=dashed, arrowhead=vee, arrowsize=0.7, label="«include»"];
"del_eli" -> "desactivar" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»", constraint=true, weight=1];
"del_valid" -> "error_valid" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
"buscar" -> "sin_resultados" [style=dashed, dir=back, arrowtail=vee, arrowsize=0.7, label="«extend»"];
}